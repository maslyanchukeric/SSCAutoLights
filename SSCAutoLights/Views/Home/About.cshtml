@{
    ViewData["Title"] = "About Us";
}

<!-- =========================
     ABOUT HERO
========================= -->
<section class="about-hero">

    <div class="about-hero-overlay"></div>

    <div class="about-hero-content">

        <span class="about-label">
            ABOUT SSC AUTO LIGHTS
        </span>

        <h1>
            Built Around OEM<br />
            Automotive Lighting
        </h1>

        <p>
            We purchase used and damaged OEM automotive lighting
            and supply restored OEM replacement headlights.
        </p>

    </div>

</section>


<!-- =========================
     ABOUT INTRO
========================= -->
<section class="about-intro">

    <div class="about-intro-grid">

        <!-- LEFT SIDE -->
        <div class="about-intro-image">

            <img src="/images/headlight.png"
                 alt="OEM automotive headlight" />

        </div>


        <!-- RIGHT SIDE -->
        <div class="about-intro-text">

            <span class="about-section-label">
                WHO WE ARE
            </span>

            <h2>
                OEM Automotive Lighting
                <strong>Is What We Do</strong>
            </h2>

            <p>
                SSC Auto Lights specializes in OEM automotive lighting,
                with a focus on purchasing used and damaged headlight
                cores and supplying restored OEM replacement headlights.
            </p>

            <p>
                We work with collision centers, body shops, dealerships,
                recyclers, and other automotive businesses that have
                OEM lighting and selected automotive components available
                for sale.
            </p>

            <p>
                Damaged doesn't always mean worthless. Many OEM headlights
                and components can still have value even when they have
                broken tabs, damaged housings, cracked lenses, or other
                repairable damage.
            </p>

            <a asp-controller="Home"
               asp-action="Contact"
               class="about-button">
               Contact SSC Auto Light
           </a>

        </div>

    </div>

</section>